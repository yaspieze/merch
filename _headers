# Security headers. GitHub Pages ignores this file; Cloudflare, which
# sits in front of store.fngl.ir, does not.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'none'; script-src 'sha256-5yDCzIKOtFOGOJQ6vHdpstsa6eE0ZvQMWJoKd2/QL9k=' 'sha256-NNYBa0mCwWGCPQnpmhjOpD/m/jidZm0Pj+jh3/6pcaA='; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; worker-src 'none'; upgrade-insecure-requests
